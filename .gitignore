# Go
/pokkum
/pokkum-test
/pokkum-init
*.test
*.out
/dist/
/.pokkum/
/.gocache/

# Stray root-level static server build artifact
/pokkum-static

# Stray root-level artifact from `go build ./scripts/gen-docs/...` (no -o
# flag defaults the output binary's name to the package directory name).
/gen-docs

# Generated supervisor binaries
internal/adapters/supervisor/bin/pokkum-init-*

# Generated static server binaries
internal/adapters/staticserver/bin/pokkum-static-*

# Node/SvelteKit build output in test fixtures
node_modules/
.svelte-kit/
testdata/fixtures/*/dist/

# macOS
.DS_Store

# Editor
.idea/
.vscode/
.gomodcache/cache/download/

# Generated .pokkum/ sandboxes inside test fixtures. Pokkum writes virtual
# configs and patched handlers here during a build; e2e runs leave one
# content-hashed handler per run, so tracking them grows the repo on every
# test run. The deliberate patch-target corpus lives in testdata/adapter-node/.
testdata/fixtures/*/.pokkum/

# Generated by a real build against a fixture. Tests now copy fixtures into
# t.TempDir() before building (see tests/integration/harness_test.go), so this
# should not appear -- it is ignored as belt-and-suspenders so an in-place write
# can never be committed the way the .pokkum/ handlers once were.
testdata/fixtures/*/pokkum.lock

# npm auth lives here. Never commit it: an .npmrc in the repo root is one
# `git add -A` away from publishing a write-scoped token with 2FA bypass, and
# pokkum's own secretguard will not catch it — .npmrc's format is unquoted
# (//registry.npmjs.org/:_authToken=npm_xxx) and the generic secret rule
# requires a quoted value.
.npmrc
