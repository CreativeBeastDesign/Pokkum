# Variant 1 — "the Dockerfile most people write first".
#
# This is deliberately NOT a straw man: it is the shape that appears in the
# majority of SvelteKit deployment blog posts and Stack Overflow answers. It
# works. The point of the comparison is what it costs, not whether it runs.
#
# What it inherits by being written this way:
#   - a full Node base image, which means a shell, a package manager, and the
#     OS packages they pull in — all of it in the runtime layer, all of it
#     scannable;
#   - devDependencies shipped into the final image, because the build and the
#     runtime are the same stage;
#   - a non-reproducible build: `npm install` resolves at build time and the
#     image is stamped with the wall clock;
#   - PID 1 is node, so it reaps no zombies and forwards no signals — a
#     `docker stop` waits the full grace period rather than shutting down.
FROM node:22

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build

EXPOSE 3000
CMD ["node", "build"]
