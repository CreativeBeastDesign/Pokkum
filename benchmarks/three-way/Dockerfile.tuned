# Variant 2 — "the Dockerfile someone who knows what they're doing writes".
#
# This is the fair comparison, and the one worth beating. Multi-stage so the
# toolchain never reaches the runtime layer, alpine base, production-only
# dependencies, a non-root user, and tini as PID 1 for signal handling and
# zombie reaping.
#
# What it still cannot give you, no matter how carefully it is written:
#   - a shell and a package manager remain in the image (that is what alpine
#     IS), so the runtime attack surface and the CVE feed stay non-empty;
#   - `npm ci` resolves against the network at image-build time, so the image
#     is not reproducible from source alone;
#   - no SBOM, no provenance, no signature, unless you bolt on more tooling;
#   - every layer is invalidated by any source change, since COPY . . is one
#     cache key for the whole tree.
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build && npm prune --omit=dev

FROM node:22-alpine AS runtime

RUN apk add --no-cache tini && \
    addgroup -g 10001 -S app && \
    adduser -u 10001 -S app -G app

WORKDIR /app

COPY --from=builder --chown=app:app /app/build ./build
COPY --from=builder --chown=app:app /app/node_modules ./node_modules
COPY --from=builder --chown=app:app /app/package.json ./package.json

USER app
EXPOSE 3000

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "build"]
