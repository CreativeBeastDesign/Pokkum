# Variant 3 — "Tuned Caddy Alpine Dockerfile"
#
# Caddy web server on Alpine: modern, fast, single binary web server.
#
# What it inherits:
#   - Full Alpine runtime base (shell, apk);
#   - Higher base binary footprint than dedicated small C/Go web servers;
#   - Non-reproducible timestamps.

FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM caddy:alpine AS runtime

COPY --from=builder /app/build /usr/share/caddy
COPY Caddyfile /etc/caddy/Caddyfile

EXPOSE 80
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
