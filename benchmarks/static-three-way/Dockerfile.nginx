# Variant 1 — "Standard Nginx Dockerfile"
#
# Standard Debian-based nginx image. This is the simplest and most common
# Dockerfile used to serve static builds in tutorials and starters.
#
# What it inherits:
#   - Full Debian base with apt, shell, and standard OS packages;
#   - High CVE exposure from OS utilities;
#   - Non-reproducible timestamps by default;
#   - Standard uncompressed asset serving unless manually configured.

FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:latest AS runtime

COPY --from=builder /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
