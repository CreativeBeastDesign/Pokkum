# Variant 2 — "Tuned Nginx Alpine Dockerfile"
#
# A tuned multi-stage build using nginx:alpine with a non-root unprivileged
# user setup, targeted nginx config, and minimal runtime footprint.
#
# What it still cannot give you:
#   - Alpine still contains a shell (/bin/sh) and package manager (apk);
#   - Non-reproducible container layers;
#   - No cryptographic provenance / SBOM / SLSA without external pipeline steps.

FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:alpine AS runtime

COPY --from=builder /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
